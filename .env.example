# Directus 로컬 개발 환경 예시입니다. 실제 값은 .env에만 입력합니다.
KEY=replace-with-a-local-project-key
SECRET=replace-with-a-long-random-local-secret

DB_CLIENT=sqlite3
DB_FILENAME=./data/directus.sqlite
DIRECTUS_URL=http://127.0.0.1:8055
DIRECTUS_ASSETS_URL=http://127.0.0.1:8055

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-local-admin-password

HOST=127.0.0.1
PORT=8055
PUBLIC_URL=http://127.0.0.1:8055
CORS_ENABLED=true
CORS_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_DIRECTUS_ADMIN_URL=http://127.0.0.1:8055/admin
