# Copy this file to .env.docker before starting Docker Compose.
# Generate KEY and SECRET with: openssl rand -hex 32
KEY=replace-with-a-32-byte-random-key
SECRET=replace-with-a-32-byte-random-secret

# Docker Compose deliberately publishes Directus on 8056 at first so it can
# run beside the existing local Directus development server on 8055.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-local-admin-password

PUBLIC_URL=http://127.0.0.1:8056
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
