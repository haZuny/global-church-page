{
  "name": "global-church-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "start": "next start",
    "lint": "next lint",
    "cms:bootstrap": "directus bootstrap",
    "cms:start": "directus start",
    "cms:docker:up": "docker compose --project-name global-church-preview --env-file .env.docker up -d",
    "cms:docker:down": "docker compose --project-name global-church-preview --env-file .env.docker down",
    "cms:docker:logs": "docker compose --project-name global-church-preview --env-file .env.docker logs -f directus",
    "cms:model:apply": "node scripts/directus/apply-content-model.mjs",
    "cms:permissions:apply": "node scripts/directus/apply-public-read-policy.mjs",
    "cms:files:permissions": "node scripts/directus/apply-published-file-read-policy.mjs",
    "cms:editor:ko": "node scripts/directus/apply-korean-editor-ux.mjs",
    "cms:media:relations": "node scripts/directus/apply-file-relations.mjs",
    "cms:bulletin:relations": "node scripts/directus/apply-bulletin-media-relations.mjs",
    "cms:church:relations": "node scripts/directus/apply-church-info-relations.mjs",
    "cms:church:seed": "node scripts/directus/seed-church-information.mjs",
    "cms:content-assets:relations": "node scripts/directus/apply-content-asset-relation.mjs",
    "cms:content-assets:sync": "node scripts/directus/sync-content-assets.mjs",
    "cms:roles": "node scripts/directus/apply-operator-roles.mjs",
    "cms:lists:configure": "node scripts/directus/apply-content-list-presets.mjs",
    "cms:sample-content:seed": "node scripts/directus/seed-list-sample-content.mjs",
    "cms:sample-content:remove": "node scripts/directus/remove-list-sample-content.mjs"
  },
  "dependencies": {
    "directus": "11.3.5",
    "lucide-react": "^1.49.0",
    "next": "15.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sanitize-html": "^2.13.1",
    "sass": "1.86.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "22.15.2",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "typescript": "5.8.3"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
