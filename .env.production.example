# Copy this file to .env.production on the Linux server. Never commit that file.
# Generate KEY and SECRET independently: openssl rand -hex 32
KEY=replace-with-a-random-directus-key
SECRET=replace-with-a-random-directus-secret
ADMIN_EMAIL=replace-with-a-real-admin-email
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Public URLs
NEXT_PUBLIC_SITE_URL=https://globalchurch.kr
DIRECTUS_ASSETS_URL=https://cms.globalchurch.kr
NEXT_PUBLIC_DIRECTUS_ADMIN_URL=https://cms.globalchurch.kr/admin
PUBLIC_URL=https://cms.globalchurch.kr
CORS_ORIGIN=https://globalchurch.kr

# Optional ownership-verification values issued after the site is public.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
